{
	"name": "emdash-inbox",
	"version": "0.10.0",
	"description": "Inbox-by-Google-style mailbox UI for EmDash CMS, with Cloudflare Email Service transport built in",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"mailbox",
		"inbox",
		"email",
		"cms",
		"cloudflare-email",
		"cloudflare-workers",
		"cloudflare"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proverbiallemon/emdash-inbox.git"
	},
	"homepage": "https://github.com/proverbiallemon/emdash-inbox#readme",
	"bugs": {
		"url": "https://github.com/proverbiallemon/emdash-inbox/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./admin": {
			"types": "./dist/admin.d.mts",
			"default": "./dist/admin.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"vendor",
		"patches",
		"scripts/vendor-mime.mjs",
		"tsdown.config.ts",
		"tsconfig.json",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"scripts": {
		"build": "node scripts/vendor-mime.mjs --check && tsdown",
		"prepare": "node scripts/vendor-mime.mjs --check && tsdown",
		"vendor:mime": "node scripts/vendor-mime.mjs",
		"typecheck": "tsc --noEmit",
		"validate": "pnpm build && node scripts/native-validate.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"dev:preview": "vite --config dev/vite.config.ts"
	},
	"peerDependencies": {
		"emdash": "^0.38.0",
		"react": "^19"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "19",
		"@types/sanitize-html": "^2.16.1",
		"emdash": "^0.38.0",
		"jsdom": "^30.0.1",
		"kysely": "^0.29.0",
		"react": "^19",
		"react-dom": "19.2.5",
		"tsdown": "^0.21.9",
		"typescript": "^6.0.3",
		"vite": "7.3.2",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@tiptap/extension-image": "3.22.4",
		"@tiptap/extension-text-align": "3.22.4",
		"@tiptap/extension-text-style": "3.22.4",
		"@tiptap/pm": "^3.22.4",
		"@tiptap/react": "^3.22.4",
		"@tiptap/starter-kit": "^3.22.4",
		"dompurify": "^3.4.0",
		"htmlparser2": "10.1.0",
		"postal-mime": "2.7.4",
		"sanitize-html": "2.17.7",
		"zod": "^4.5.4"
	},
	"pnpm": {
		"patchedDependencies": {
			"postal-mime@2.7.4": "patches/postal-mime@2.7.4.patch"
		}
	}
}
